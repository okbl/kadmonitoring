node_modules/

# Собранный офлайн-файл с русским именем — дубль dist/index.html, в репозитории не нужен
dist/Обособленный спор.html

# Персональные данные: карточки дел и сохранённые споры не должны попасть в git
*.mhtml
*.json
!package.json
!package-lock.json
!test/fixtures/*.json
!extension/manifest.json

# Шрифт качается локально (tools/fetch-font.mjs), в git не хранится
src/fonts/

# Сервер: отслеживаемые споры, кэш текстов актов и профиль браузера с cookies
data/
.kad-profile/

# Сборка расширения — выкладывается на сайт (npm run pages), в git не хранится
dist/extension/
dist/*.zip
